# Copiar a .env y completar. El archivo .env no se sube al repo.

# PostgreSQL
POSTGRES_USER=studyleague
POSTGRES_PASSWORD=cambiar-esto
POSTGRES_DB=studyleague

# Kafka
KAFKA_BROKERS=kafka:9092
# Particiones del tópico partida.finalizada (punto sensible: máximo de consumidores en paralelo por grupo)
PARTIDA_PARTICIONES=3
# Retención en horas (punto sensible: cuánto historial se puede reprocesar). 168 h = 7 días
RETENCION_HORAS=168

# Regla de bajo dominio (sección 6.2 del white paper)
BAJO_DOMINIO_MIN_RESPUESTAS=10
BAJO_DOMINIO_UMBRAL=0.40

# API: secreto para firmar los tokens JWT de sesión (mínimo 32 caracteres).
# En local es opcional (hay un valor por defecto solo para la PoC). En la nube es obligatorio.
# Generalo con: openssl rand -hex 32
JWT_SECRET=

# Puertos expuestos en la máquina local
API_PORT=3000
WEB_PORT=5173
KAFKA_UI_PORT=8080

# Solo para el deploy en la nube (docker-compose.prod.yml + Caddy)
DOMINIO=studyleague.example.com
BASIC_AUTH_USER=catedra
# Hash generado con: docker run --rm caddy:2.11.7 caddy hash-password --plaintext 'tu-clave'
# Va entre comillas simples porque tiene signos $ (ej.: BASIC_AUTH_HASH='$2a$14$...').
BASIC_AUTH_HASH=
# En la VM, para que cualquier `docker compose` (incluido demo-reset) use también el archivo de producción:
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
