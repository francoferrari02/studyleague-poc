# Proxy del deploy en la nube (docker-compose.prod.yml).
# Caddy obtiene el certificado HTTPS solo, a partir del dominio.
# Kafka, PostgreSQL y Redis no se exponen.
#
# Credenciales en dos niveles:
# - La web, Swagger y Kafka UI quedan detrás de usuario y contraseña (basic auth).
# - El login de la API requiere basic auth para que las cuentas públicas de demo
#   no permitan obtener un JWT sin la credencial entregada a la cátedra.
# - Las demás rutas /api/* usan JWT en Authorization: Bearer. No llevan basic auth
#   porque ese header reemplaza las credenciales Basic del navegador.

(credenciales) {
	basic_auth {
		{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
	}
}

{$DOMINIO} {
	@swagger path /api/docs /api/docs/*
	handle @swagger {
		import credenciales
		uri strip_prefix /api
		reverse_proxy api:3000
	}

	# Swagger UI pide sus archivos con rutas absolutas (/docs/static/..., /docs/json).
	handle /docs* {
		import credenciales
		reverse_proxy api:3000
	}

	handle /api/auth/* {
		import credenciales
		uri strip_prefix /api
		reverse_proxy api:3000
	}

	handle_path /api/* {
		reverse_proxy api:3000
	}

	# Kafka UI corre con SERVER_SERVLET_CONTEXT_PATH=/kafka-ui, por eso no se recorta la ruta.
	handle /kafka-ui* {
		import credenciales
		reverse_proxy kafka-ui:8080
	}

	handle {
		import credenciales
		reverse_proxy web:80
	}
}
